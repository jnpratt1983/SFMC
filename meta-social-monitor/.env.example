# Meta: system user token generated in Business Manager (see README step 2).
# Permissions: pages_show_list, pages_read_engagement, pages_read_user_content, read_insights,
# instagram_basic, instagram_manage_insights, business_management. Read only, never expiring.
META_ACCESS_TOKEN=
META_PAGE_ID=                # Facebook Page id (python -m monitor.main --probe lists them)
META_IG_USER_ID=             # Instagram business account id (same probe)
META_API_VERSION=v23.0

# Slack incoming webhook for the alerts channel
SLACK_WEBHOOK_URL=

# Optional: enables the plain-English summary at the top of the report
ANTHROPIC_API_KEY=

# Optional: Salesforce push (same External Client App as the journey monitor). Blank SF_DOMAIN skips it.
SF_DOMAIN=
SF_CLIENT_ID=
SF_CLIENT_SECRET=
