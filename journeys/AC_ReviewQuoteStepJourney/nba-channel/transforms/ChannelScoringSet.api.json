    "FORMULA1": {
     "action": "formula",
     "sources": [
      "FORMULA0"
     ],
     "parameters": {
      "expressionType": "SQL",
      "fields": [
       {
        "businessType": "Text",
        "defaultValue": "",
        "formulaExpression": "case when Email__c is null or Email__c = '' then 'none' when lower(Email__c) like '%@gmail.com' then 'gmail' when lower(Email__c) like '%@yahoo.com' or lower(Email__c) like '%@ymail.com' or lower(Email__c) like '%@myyahoo.com' or lower(Email__c) like '%@rocketmail.com' then 'yahoo' when lower(Email__c) like '%@icloud.com' or lower(Email__c) like '%@me.com' or lower(Email__c) like '%@mac.com' then 'apple' when lower(Email__c) like '%@hotmail.com' or lower(Email__c) like '%@outlook.com' or lower(Email__c) like '%@live.com' or lower(Email__c) like '%@msn.com' then 'microsoft' when lower(Email__c) like '%@aol.com' then 'aol' when lower(Email__c) like '%@cox.net' or lower(Email__c) like '%@comcast.net' or lower(Email__c) like '%@att.net' or lower(Email__c) like '%@sbcglobal.net' or lower(Email__c) like '%@verizon.net' or lower(Email__c) like '%@charter.net' then 'isp' when lower(Email__c) like '%.edu' then 'edu' when lower(Email__c) like '%@proton.me' or lower(Email__c) like '%@protonmail.com' or lower(Email__c) like '%@mail.com' then 'privacy' else 'other' end",
        "label": "Email Domain",
        "name": "Email_Domain__c",
        "precision": 20,
        "type": "TEXT"
       }
      ]
     }
    },
